<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:paddingStart="16dp"
    android:paddingEnd="8dp">

    <ImageView
        android:id="@+id/appIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/appName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/appInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp" />

        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:chipSpacingHorizontal="4dp"
            app:chipSpacingVertical="4dp">

            <TextView android:id="@+id/badgeRecent" style="@style/Badge"
                android:background="@drawable/badge_new" android:textColor="@color/badge_new_fg" android:text="@string/badge_recent" />
            <TextView android:id="@+id/badgeGame" style="@style/Badge" />
            <TextView android:id="@+id/badgeSource" style="@style/Badge" />
            <TextView android:id="@+id/badgeMine" style="@style/Badge"
                android:background="@drawable/badge_mine" android:textColor="@color/badge_other_fg" android:text="@string/badge_mine" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>

    <CheckBox
        android:id="@+id/appCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:clickable="false"
        android:focusable="false" />
</LinearLayout>
